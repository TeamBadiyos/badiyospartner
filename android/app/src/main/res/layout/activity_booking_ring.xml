<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen incoming-booking alert (shown over the lockscreen).
  Colours match the app theme: primary #0074E4, charcoal #222831.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0074E4"
    android:padding="24dp">

    <TextView
        android:id="@+id/ring_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BADIYOS EXPERT"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/ring_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New booking"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/ring_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#EAF3FF"
        android:textSize="18sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/ring_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ring_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ring_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:gravity="center" />

    <Button
        android:id="@+id/ring_accept"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:text="Accept"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#0074E4"
        android:backgroundTint="#FFFFFF" />

    <Button
        android:id="@+id/ring_reject"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Reject"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565D8" />

    <Button
        android:id="@+id/ring_ok"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:text="OK"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#0074E4"
        android:backgroundTint="#FFFFFF"
        android:visibility="gone" />

</LinearLayout>
